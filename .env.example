# ========================================================
# SAKANAA-WHATSWAP CONFIGURATION (V2 - LOCAL / TERMUX)
# ========================================================

# Session storage folder name (relative to project root)
SESSION_NAME=session

# Target phone number for pairing code authentication (e.g. 6281234567890)
PHONE_NUMBER=6281234567890

# Auto-reconnection enabled (true/false)
AUTO_RECONNECT=true

# Maximum consecutive reconnection attempts before exiting
MAX_RECONNECT_ATTEMPTS=15

# Watchdog idle timeout in milliseconds (e.g. 240000 = 4 minutes)
WATCHDOG_IDLE_TIMEOUT_MS=240000

# Baileys internal pino logger level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent')
BAILEYS_LOG_LEVEL=silent

# Rate limiter delay mode: 'auto', ms number (e.g. 1500), or 'false'
RATE_LIMIT_DELAY=auto

# Default Sticker metadata
STICKER_PACK_NAME=Sakanaa-Whatswap
STICKER_AUTHOR_NAME=Sakanaa Bot
